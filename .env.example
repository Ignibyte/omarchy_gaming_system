OGS_BIND_ADDRESS=127.0.0.1:8080
OGS_SERVER_NAME=OmarchyGS Community
DATABASE_URL=postgres://omarchy_gaming_system:omarchy_gaming_system@127.0.0.1:5432/omarchy_gaming_system
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
OGS_MFA_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
# The public key and cartridge store must be set together at server startup to
# advertise and serve exact cartridge acquisitions. The origin and TLS root are
# additionally required by the operator-only marketplace synchronization command.
# OGS_MARKETPLACE_ORIGIN=https://marketplace.example.com/v1/
# OGS_MARKETPLACE_PUBLIC_KEY=/etc/omarchygs/marketplace-public.json
# OGS_MARKETPLACE_TLS_ROOT_DER=/etc/omarchygs/marketplace-root.der
# OGS_CARTRIDGE_STORE_ROOT=/var/lib/omarchygs/cartridges
RUST_LOG=omarchy_gaming_system_server=debug,tower_http=debug
